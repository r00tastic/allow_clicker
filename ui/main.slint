import { LineEdit, ScrollView, Slider } from "std-widgets.slint";

// ==== STEP ITEM STRUCT ====
export struct StepItem {
    word: string,
    delay-secs: float,
    stop: bool,  // true = tikla ve dur, false = tikla ve bekle
}

// ==== STEP ROW ====
component StepRow inherits Rectangle {
    in property <string> word;
    in property <float> delay-secs;
    in property <int> index;
    in property <int> total;
    in property <bool> active;
    in property <bool> can-remove;
    in property <bool> stop;
    callback remove();

    height: 40px;
    border-radius: 10px;
    background: root.active ? rgba(85,224,138,0.08) : rgba(255,255,255,0.02);
    border-width: 1px;
    border-color: root.active ? rgba(85,224,138,0.3) : #262c3a;
    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        alignment: center;

        // Sira numarasi
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: root.active
                ? @linear-gradient(135deg, #55e08a, #4de3ce)
                : #232838;
            animate background { duration: 200ms; }

            Text {
                text: "\{root.index + 1}";
                color: root.active ? #0a0d14 : #7d8598;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Kelime
        Text {
            text: root.word;
            color: root.active ? #55e08a : #eaf0ff;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            animate color { duration: 200ms; }
        }

        // Ok isareti (sonraki adima) veya dur isareti
        if !root.stop && root.index < root.total - 1: Text {
            text: "→";
            color: #4d5468;
            font-size: 14px;
            vertical-alignment: center;
        }
        if !root.stop && root.index == root.total - 1 && root.total > 1: Text {
            text: "↻";
            color: #4d5468;
            font-size: 14px;
            vertical-alignment: center;
        }

        // Bekleme suresi veya DUR etiketi
        if !root.stop: Rectangle {
            width: 56px;
            height: 24px;
            border-radius: 6px;
            background: rgba(124,156,255,0.08);
            border-width: 1px;
            border-color: rgba(124,156,255,0.2);

            Text {
                text: "\{root.delay-secs}s";
                color: #7c9cff;
                font-family: "Consolas";
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if root.stop: Rectangle {
            width: 56px;
            height: 24px;
            border-radius: 6px;
            background: rgba(255,92,124,0.12);
            border-width: 1px;
            border-color: rgba(255,92,124,0.3);

            Text {
                text: "DUR";
                color: #ff5c7c;
                font-family: "Consolas";
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Sil butonu
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: rm.has-hover ? rgba(255,92,124,0.18) : transparent;
            animate background { duration: 160ms; }
            opacity: root.can-remove ? 1.0 : 0.3;

            Text {
                text: "×";
                color: rm.has-hover && root.can-remove ? #ff5c7c : #7d8598;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
                animate color { duration: 160ms; }
            }
            rm := TouchArea {
                mouse-cursor: pointer;
                enabled: root.can-remove;
                clicked => { root.remove(); }
            }
        }
    }
}

// ==== ICONS (Path-based) ====

component IconReticle inherits Path {
    in property <brush> tint: #071016;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    stroke-width: 1.6px;
    fill: transparent;
    commands: "M 12 3 A 9 9 0 1 1 12 21 A 9 9 0 1 1 12 3 M 12 8 A 4 4 0 1 1 12 16 A 4 4 0 1 1 12 8 M 12 0 L 12 3 M 12 21 L 12 24 M 0 12 L 3 12 M 21 12 L 24 12";
}

component IconDiamond inherits Path {
    in property <brush> tint: #4de3ce;
    viewbox-width: 8;
    viewbox-height: 8;
    fill: root.tint;
    commands: "M 4 0 L 8 4 L 4 8 L 0 4 Z";
}

component IconCrosshair inherits Path {
    in property <brush> tint: #4de3ce;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: root.tint;
    stroke-width: 1.4px;
    fill: transparent;
    commands: "M 8 2 L 8 5 M 8 11 L 8 14 M 2 8 L 5 8 M 11 8 L 14 8 M 8 5 A 3 3 0 1 1 8 11 A 3 3 0 1 1 8 5";
}

component IconPlus inherits Path {
    in property <brush> tint: #071016;
    viewbox-width: 14;
    viewbox-height: 14;
    stroke: root.tint;
    stroke-width: 2.2px;
    fill: transparent;
    commands: "M 7 2 L 7 12 M 2 7 L 12 7";
}

// ==== NEON TOGGLE ====
component NeonToggle inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    in property <string> sub-label;
    in property <bool> enabled: true;

    height: 44px;

    HorizontalLayout {
        spacing: 12px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;
            Text { text: root.label; color: #eaf0ff; font-size: 13px; }
            Text { text: root.sub-label; color: #7d8598; font-size: 11px; }
        }

        Rectangle {
            width: 40px;
            height: 22px;
            y: (parent.height - 22px) / 2;
            border-radius: 11px;
            background: root.checked
                ? @linear-gradient(135deg, #4de3ce, #7c9cff)
                : #232838;
            animate background { duration: 200ms; }
            opacity: root.enabled ? 1.0 : 0.4;

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.checked ? #0a0d14 : #7d8598;
                x: root.checked ? 21px : 3px;
                y: 3px;
                animate x { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                animate background { duration: 180ms; }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { if (root.enabled) { root.checked = !root.checked; } }
            }
        }
    }
}

// ==== FAB (Floating Action Button) ====
component Fab inherits Rectangle {
    in property <bool> running;
    callback clicked();

    width: 64px;
    height: 64px;
    border-radius: 32px;

    Rectangle {
        x: -6px; y: -6px;
        width: parent.width + 12px;
        height: parent.height + 12px;
        border-radius: (parent.width + 12px) / 2;
        background: transparent;
        border-color: root.running ? #55e08a : #ff5c7c;
        border-width: root.running ? 2px : 1px;
        opacity: root.running ? 0.6 : 0.3;
    }

    fab-btn := Rectangle {
        width: 64px;
        height: 64px;
        border-radius: 32px;
        background: root.running
            ? @linear-gradient(135deg, #55e08a, #4de3ce)
            : @linear-gradient(135deg, #ff5c7c, #ff8a5c);
        drop-shadow-color: root.running
            ? rgba(85, 224, 138, 0.4)
            : rgba(255, 92, 124, 0.4);
        drop-shadow-blur: fab-ta.has-hover ? 12px : 0;
        drop-shadow-offset-y: fab-ta.has-hover ? 2px : 0;
        animate background { duration: 220ms; }
        animate drop-shadow-blur { duration: 160ms; }

        if !root.running: Path {
            width: 18px;
            height: 20px;
            x: (parent.width - self.width) / 2 + 2px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 18;
            viewbox-height: 20;
            fill: #ffffff;
            commands: "M 0 0 L 18 10 L 0 20 Z";
        }
        if root.running: Rectangle {
            width: 18px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            HorizontalLayout {
                spacing: 4px;
                Rectangle { width: 6px; background: #0a0d14; border-radius: 1px; }
                Rectangle { width: 6px; background: #0a0d14; border-radius: 1px; }
            }
        }

        fab-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

// ==== CARD ====
component Card inherits Rectangle {
    in property <string> title;
    in property <string> badge;

    background: @linear-gradient(180deg, rgba(255,255,255,0.02), transparent 40%);
    Rectangle {
        background: #12161f;
        border-radius: 14px;
        border-width: 1px;
        border-color: #262c3a;
    }
    border-radius: 14px;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                alignment: start;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - 8px) / 2;
                    IconDiamond { width: 100%; height: 100%; }
                }
                Text {
                    text: root.title;
                    color: #7d8598;
                    font-size: 11px;
                    font-weight: 500;
                    letter-spacing: 1.2px;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.badge;
                color: #4d5468;
                font-family: "Consolas";
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        @children
    }
}

// ==== MAIN WINDOW ====
export component MainWindow inherits Window {
    title: "Allow Clicker";
    preferred-width: 900px;
    preferred-height: 760px;
    min-width: 720px;
    min-height: 640px;
    background: #0a0d14;

    // --- Adimlar ---
    in-out property <[StepItem]> steps: [{ word: "Allow", delay-secs: 1.5 }];
    in-out property <bool> case-sensitive: false;
    in-out property <bool> dry-run: false;

    in-out property <int> region-x: 0;
    in-out property <int> region-y: 0;
    in-out property <int> region-w: 0;
    in-out property <int> region-h: 0;

    in-out property <string> rx-text: "0";
    in-out property <string> ry-text: "0";
    in-out property <string> rw-text: "0";
    in-out property <string> rh-text: "0";
    in-out property <string> new-word: "";
    in-out property <string> new-delay: "1.5";
    in-out property <bool> new-stop: false;

    in-out property <float> interval-ms: 500.0;

    // --- Durum ---
    in-out property <bool> running: false;
    in-out property <string> status-text: "Bekleme";
    in-out property <int> click-count: 0;
    in-out property <string> uptime-text: "00:00";
    in-out property <string> log-text: "";
    in-out property <int> current-step: -1;

    changed region-x => { rx-text = "\{root.region-x}"; }
    changed region-y => { ry-text = "\{root.region-y}"; }
    changed region-w => { rw-text = "\{root.region-w}"; }
    changed region-h => { rh-text = "\{root.region-h}"; }

    // --- Callbacks ---
    callback pick-region();
    callback toggle-running();
    callback save-config();
    callback clear-log();
    callback add-step(string, float, bool);
    callback remove-step(int);

    // ==== WRAPPER ====
    Rectangle {
    background: transparent;

    VerticalLayout {
        // Sticky status bar
        Rectangle {
            height: 52px;
            background: rgba(18,22,31, 0.95);

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #262c3a;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 12px;
                alignment: start;

                // Brand logo
                Rectangle {
                    width: 32px;
                    height: 32px;
                    y: (parent.height - 32px) / 2;
                    border-radius: 10px;
                    background: @linear-gradient(135deg, #4de3ce, #7c9cff);
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        x: 6px; y: 6px;
                        IconReticle { width: 100%; height: 100%; tint: #071016; }
                    }
                    Rectangle {
                        width: 3px;
                        height: 3px;
                        x: 14.5px;
                        y: 14.5px;
                        border-radius: 1.5px;
                        background: #071016;
                    }
                }

                Text {
                    text: "Allow Clicker";
                    color: #eaf0ff;
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                // Status pill
                Rectangle {
                    width: status-content.preferred-width + 24px;
                    height: 26px;
                    y: (parent.height - 26px) / 2;
                    border-radius: 13px;
                    background: root.running ? rgba(85,224,138, 0.12) : rgba(125,133,152, 0.08);
                    border-width: 1px;
                    border-color: root.running ? rgba(85,224,138, 0.3) : rgba(125,133,152, 0.2);
                    animate background { duration: 200ms; }

                    status-content := HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - 8px) / 2;
                            border-radius: 4px;
                            background: root.running ? #55e08a : #7d8598;
                        }
                        Text {
                            text: root.status-text;
                            color: root.running ? #55e08a : #a0a5b0;
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Adim chip
                if root.running && root.current-step >= 0: Rectangle {
                    width: step-hbox.preferred-width + 20px;
                    height: 26px;
                    y: (parent.height - 26px) / 2;
                    border-radius: 8px;
                    background: rgba(85,224,138,0.1);
                    border-width: 1px;
                    border-color: rgba(85,224,138,0.3);

                    step-hbox := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;
                        Text { text: "Adım"; color: #55e08a; font-size: 12px; vertical-alignment: center; }
                        Text {
                            text: "\{root.current-step + 1}/\{root.steps.length}";
                            color: #eaf0ff;
                            font-family: "Consolas";
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }

                // Tik chip
                Rectangle {
                    width: click-hbox.preferred-width + 20px;
                    height: 26px;
                    y: (parent.height - 26px) / 2;
                    border-radius: 8px;
                    background: #12161f;
                    border-width: 1px;
                    border-color: #262c3a;

                    click-hbox := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;
                        Text { text: "Tıklama"; color: #7d8598; font-size: 12px; vertical-alignment: center; }
                        Text {
                            text: "\{root.click-count}";
                            color: #eaf0ff;
                            font-family: "Consolas";
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }
                // Uptime chip
                Rectangle {
                    width: up-hbox.preferred-width + 20px;
                    height: 26px;
                    y: (parent.height - 26px) / 2;
                    border-radius: 8px;
                    background: #12161f;
                    border-width: 1px;
                    border-color: #262c3a;

                    up-hbox := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;
                        Text { text: "Uptime"; color: #7d8598; font-size: 12px; vertical-alignment: center; }
                        Text {
                            text: root.uptime-text;
                            color: #eaf0ff;
                            font-family: "Consolas";
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Content
        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            // Card: Adimlar
            Card {
                title: "ADIMLAR";
                badge: "\{root.steps.length} adım";

                // Adim listesi
                VerticalLayout {
                    spacing: 6px;
                    for item[idx] in root.steps: StepRow {
                        word: item.word;
                        delay-secs: item.delay-secs;
                        index: idx;
                        total: root.steps.length;
                        active: root.running && root.current-step == idx;
                        can-remove: !root.running && root.steps.length > 1;
                        stop: item.stop;
                        remove => { root.remove-step(idx); }
                    }
                }

                // Ekleme satiri
                Rectangle {
                    height: 1px;
                    background: #232838;
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.new-word;
                        placeholder-text: "Kelime (ör: Join)";
                        horizontal-stretch: 1;
                        enabled: !root.running;
                        accepted(t) => {
                            if (t != "") {
                                root.add-step(t, root.new-delay.to-float(), root.new-stop);
                                root.new-word = "";
                            }
                        }
                    }
                    // Bekleme suresi input
                    if !root.new-stop: VerticalLayout {
                        spacing: 2px;
                        Text { text: "Bekleme (s)"; color: #7d8598; font-size: 10px; }
                        LineEdit {
                            text <=> root.new-delay;
                            placeholder-text: "1.5";
                            width: 70px;
                            enabled: !root.running;
                        }
                    }
                    // Bekle/Dur secici
                    Rectangle {
                        width: 52px;
                        height: 28px;
                        y: 8px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: root.new-stop ? rgba(255,92,124,0.4) : rgba(85,224,138,0.4);
                        background: root.new-stop ? rgba(255,92,124,0.1) : rgba(85,224,138,0.1);
                        animate background { duration: 160ms; }
                        animate border-color { duration: 160ms; }

                        Text {
                            text: root.new-stop ? "DUR" : "BEKLE";
                            color: root.new-stop ? #ff5c7c : #55e08a;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            animate color { duration: 160ms; }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            enabled: !root.running;
                            clicked => { root.new-stop = !root.new-stop; }
                        }
                    }
                    // + Ekle butonu
                    Rectangle {
                        width: 88px;
                        height: 32px;
                        y: 12px;
                        border-radius: 8px;
                        background: add-touch.has-hover
                            ? @linear-gradient(135deg, #5eebd8, #8ba8ff)
                            : @linear-gradient(135deg, #4de3ce, #7c9cff);
                        drop-shadow-color: add-touch.has-hover ? rgba(77,227,206, 0.4) : transparent;
                        drop-shadow-blur: add-touch.has-hover ? 8px : 0;
                        drop-shadow-offset-y: 2px;
                        animate background { duration: 160ms; }
                        animate drop-shadow-blur { duration: 160ms; }
                        opacity: !root.running && root.new-word != "" ? 1.0 : 0.35;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Rectangle {
                                width: 12px; height: 12px;
                                y: (parent.height - 12px) / 2;
                                IconPlus { width: 100%; height: 100%; tint: #071016; }
                            }
                            Text {
                                text: "Ekle";
                                color: #071016;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        add-touch := TouchArea {
                            mouse-cursor: pointer;
                            enabled: !root.running && root.new-word != "";
                            clicked => {
                                root.add-step(root.new-word, root.new-delay.to-float(), root.new-stop);
                                root.new-word = "";
                            }
                        }
                    }
                }

                // Toggle'lar
                Rectangle {
                    height: 1px;
                    background: #232838;
                }
                NeonToggle {
                    checked <=> root.case-sensitive;
                    label: "Büyük/küçük harf duyarlı";
                    sub-label: "\"Allow\" ile \"allow\" farklı sayılır";
                    enabled: !root.running;
                }
                NeonToggle {
                    checked <=> root.dry-run;
                    label: "Dry-run modu";
                    sub-label: "Tespit et ama tıklama — test için";
                    enabled: !root.running;
                }
            }

            // Card: Bolge
            Card {
                title: "TARAMA BÖLGESİ";
                badge: root.region-w > 0 && root.region-h > 0
                    ? "\{root.region-w} × \{root.region-h} px"
                    : "seçilmedi";

                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: "X"; color: #7d8598; font-size: 10px; }
                        LineEdit {
                            text <=> root.rx-text;
                            accepted(t) => { root.region-x = Math.round(t.to-float()); }
                            enabled: !root.running;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: "Y"; color: #7d8598; font-size: 10px; }
                        LineEdit {
                            text <=> root.ry-text;
                            accepted(t) => { root.region-y = Math.round(t.to-float()); }
                            enabled: !root.running;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: "GENİŞLİK"; color: #7d8598; font-size: 10px; }
                        LineEdit {
                            text <=> root.rw-text;
                            accepted(t) => { root.region-w = Math.round(t.to-float()); }
                            enabled: !root.running;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: "YÜKSEKLİK"; color: #7d8598; font-size: 10px; }
                        LineEdit {
                            text <=> root.rh-text;
                            accepted(t) => { root.region-h = Math.round(t.to-float()); }
                            enabled: !root.running;
                        }
                    }
                }

                Rectangle {
                    height: 40px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: pick-touch.has-hover ? #4de3ce : #333b4d;
                    background: pick-touch.has-hover ? rgba(77,227,206, 0.08) : #191d28;
                    animate background { duration: 180ms; }
                    animate border-color { duration: 180ms; }
                    opacity: !root.running ? 1.0 : 0.4;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                            IconCrosshair { width: 100%; height: 100%; tint: #4de3ce; }
                        }
                        Text {
                            text: "Ekranda drag ile bölge seç";
                            color: #4de3ce;
                            font-size: 13px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                    pick-touch := TouchArea {
                        mouse-cursor: pointer;
                        enabled: !root.running;
                        clicked => { root.pick-region(); }
                    }
                }
            }

            // Card: Zamanlama
            Card {
                title: "ZAMANLAMA";

                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "Tarama aralığı";
                        color: #7d8598;
                        font-size: 12px;
                        min-width: 110px;
                        vertical-alignment: center;
                    }
                    Slider {
                        value <=> root.interval-ms;
                        minimum: 100;
                        maximum: 2000;
                        horizontal-stretch: 1;
                        enabled: !root.running;
                    }
                    Text {
                        text: "\{Math.round(root.interval-ms)}ms";
                        color: #eaf0ff;
                        font-family: "Consolas";
                        font-size: 12px;
                        min-width: 70px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                // Kaydet ve Log Sil
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 8px;
                        background: save-touch.has-hover ? #232838 : #191d28;
                        border-width: 1px;
                        border-color: #333b4d;
                        animate background { duration: 160ms; }
                        Text {
                            text: "Kaydet";
                            color: #eaf0ff;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        save-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.save-config(); }
                        }
                    }
                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 8px;
                        background: clog-touch.has-hover ? #232838 : #191d28;
                        border-width: 1px;
                        border-color: #333b4d;
                        animate background { duration: 160ms; }
                        Text {
                            text: "Log Sil";
                            color: #eaf0ff;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        clog-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.clear-log(); }
                        }
                    }
                }
            }

            // Card: Log
            Card {
                title: "CANLI LOG";
                badge: "son 100 satır";
                vertical-stretch: 1;

                Rectangle {
                    vertical-stretch: 1;
                    background: #06090f;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #262c3a;

                    ScrollView {
                        Text {
                            text: root.log-text != "" ? root.log-text : "worker durduruldu — BAŞLAT'a bas veya F8'e bas";
                            color: root.log-text != "" ? #cbd0da : #4d5468;
                            font-family: "Consolas";
                            font-size: 11px;
                            wrap: word-wrap;
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                        }
                    }
                }
            }
        }
    }

    // ==== FAB (overlay) ====
    Fab {
        x: root.width - 88px;
        y: root.height - 88px;
        running: root.running;
        clicked => { root.toggle-running(); }
    }

    Text {
        x: root.width - 60px;
        y: root.height - 24px;
        text: "F8";
        color: #7d8598;
        font-family: "Consolas";
        font-size: 10px;
    }

    } // wrapper Rectangle
}
